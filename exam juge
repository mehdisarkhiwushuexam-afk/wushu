<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IWUF — Système d'Examen des Arbitres Sanda</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;600;700&family=Source+Sans+3:wght@300;400;600;700&display=swap');

:root {
  --red: #C8102E;
  --blue: #003DA5;
  --blue-mid: #005ab5;
  --blue-light: #1a7fd4;
  --gold: #D4AF37;
  --dark: #0A0A0F;
  --surface: #13131A;
  --card: #1C1C28;
  --border: #2A2A3A;
  --text: #E8E8F0;
  --muted: #888899;
  --green: #22c55e;
  --green-dark: #16a34a;
  --orange: #F39C12;
  --header-h: 64px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Source Sans 3', sans-serif; background: var(--dark); color: var(--text); min-height: 100vh; overflow-x: hidden; }

.screen { display: none; min-height: 100vh; }
.screen.active { display: flex; flex-direction: column; animation: fadeIn .3s ease; }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
@keyframes fadeInUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
@keyframes scaleIn { from{opacity:0;transform:scale(.9)} to{opacity:1;transform:scale(1)} }
@keyframes slideLeft { from{opacity:0;transform:translateX(-16px)} to{opacity:1;transform:translateX(0)} }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.6} }
@keyframes pulseGreen { 0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,0)} 50%{box-shadow:0 0 0 8px rgba(34,197,94,.2)} }

/* LANDING */
#screen-landing {
  background: linear-gradient(135deg, #0A0A0F 0%, #0D0D1A 50%, #0A0A12 100%);
  align-items: center; justify-content: center; text-align: center; position: relative;
}
#screen-landing::before {
  content:''; position:absolute; inset:0; pointer-events:none;
  background: radial-gradient(ellipse 60% 40% at 50% 30%, rgba(0,61,165,.18) 0%, transparent 70%),
              radial-gradient(ellipse 40% 30% at 80% 80%, rgba(200,16,46,.12) 0%, transparent 60%);
}
.landing-inner { position:relative; z-index:1; padding:40px 20px; max-width:700px; margin:0 auto; animation:fadeInUp .55s ease; }
.landing-badge { display:inline-block; border:1px solid var(--gold); color:var(--gold); font-family:'Oswald',sans-serif; font-size:11px; letter-spacing:3px; padding:6px 18px; margin-bottom:28px; text-transform:uppercase; }
.landing-title { font-family:'Oswald',sans-serif; font-size:clamp(36px,6vw,72px); font-weight:700; line-height:1; margin-bottom:8px; letter-spacing:-1px; }
.landing-title .r { color:var(--red); }
.landing-title .b { color:var(--blue-light); }
.landing-sub { font-size:15px; color:var(--muted); margin-bottom:48px; letter-spacing:1px; }
.divider-line { width:80px; height:2px; background:linear-gradient(90deg,transparent,var(--gold),transparent); margin:32px auto; }
.btn-group { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
.btn-primary {
  background:linear-gradient(135deg,var(--red),#A00020); color:#fff; border:none; padding:14px 36px;
  font-family:'Oswald',sans-serif; font-size:15px; letter-spacing:2px; text-transform:uppercase; cursor:pointer;
  transition:all .2s; clip-path:polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);
}
.btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(200,16,46,.4); }
.btn-secondary {
  background:transparent; color:var(--muted); border:1px solid var(--border); padding:14px 36px;
  font-family:'Oswald',sans-serif; font-size:13px; letter-spacing:2px; text-transform:uppercase; cursor:pointer;
  transition:all .2s; clip-path:polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);
}
.btn-secondary:hover { border-color:var(--gold); color:var(--gold); }
.stats-row { display:flex; gap:40px; justify-content:center; margin-top:48px; flex-wrap:wrap; }
.stat-item { text-align:center; }
.stat-num { font-family:'Oswald',sans-serif; font-size:32px; font-weight:700; color:var(--gold); }
.stat-label { font-size:11px; color:var(--muted); letter-spacing:2px; text-transform:uppercase; }

/* LOGIN CARDS */
.login-screen-wrap {
  min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px;
  background:linear-gradient(135deg,#001f5b 0%,#003a7d 40%,#005ab5 80%,#1a7fd4 100%);
}
.login-card { background:white; border-radius:14px; box-shadow:0 20px 50px rgba(0,0,0,.3); width:100%; max-width:460px; overflow:hidden; color:#1e293b; animation:scaleIn .35s ease; }
.login-card-header { background:linear-gradient(135deg,#001f5b,#005ab5); padding:28px 24px; text-align:center; color:white; }
.login-logo { width:64px; height:64px; background:white; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 12px; font-family:'Oswald',sans-serif; font-size:26px; font-weight:900; color:#003a7d; }
.login-card-header h2 { font-family:'Oswald',sans-serif; font-size:18px; font-weight:700; }
.login-card-header p { font-size:11px; opacity:.8; margin-top:4px; }
.login-card-body { padding:24px; }
.fg { display:flex; flex-direction:column; gap:4px; margin-bottom:14px; }
.fg label { font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.5px; }
.fg input,.fg select,.fg textarea { padding:10px 14px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px; font-family:'Source Sans 3',sans-serif; transition:border-color .2s; background:white; color:#1e293b; }
.fg input:focus,.fg select:focus { outline:none; border-color:#1a7fd4; box-shadow:0 0 0 3px rgba(26,127,212,.12); }
.btn-blue { display:block; width:100%; background:linear-gradient(135deg,#003a7d,#1a7fd4); color:white; border:none; padding:13px; font-family:'Oswald',sans-serif; font-size:15px; letter-spacing:2px; text-transform:uppercase; cursor:pointer; border-radius:8px; transition:all .2s; margin-top:8px; }
.btn-blue:hover { transform:translateY(-1px); box-shadow:0 6px 20px rgba(0,90,181,.4); }
.btn-link { background:none; border:none; cursor:pointer; font-family:'Source Sans 3',sans-serif; font-size:13px; color:#005ab5; text-decoration:underline; margin-top:12px; display:block; text-align:center; }
.info-box { border-radius:8px; padding:12px 14px; font-size:13px; margin-bottom:14px; line-height:1.5; }
.info-box.info { background:#eff6ff; border:1px solid #93c5fd; color:#1e40af; }
.info-box.success { background:#f0fdf4; border:1px solid #86efac; color:#166534; }
.info-box.warning { background:#fef3c7; border:1px solid #fbbf24; color:#92400e; }
.info-box.error { background:#fef2f2; border:1px solid #fca5a5; color:#991b1b; }
.code-display { background:#f0fdf4; border:2px solid #86efac; border-radius:10px; padding:16px; text-align:center; margin-bottom:14px; }
.code-display .code { font-family:'Oswald',sans-serif; font-size:26px; font-weight:700; color:#166534; letter-spacing:2px; }
.login-error { color:var(--red); font-size:13px; margin-top:8px; display:none; text-align:center; }

/* ADMIN PANEL */
#screen-admin { background:var(--dark); }
.admin-top-bar { background:var(--surface); border-bottom:2px solid var(--border); padding:0 32px; display:flex; align-items:center; justify-content:space-between; height:var(--header-h); flex-shrink:0; }
.admin-top-bar .brand { font-family:'Oswald',sans-serif; font-size:20px; font-weight:600; letter-spacing:1px; }
.admin-top-bar .brand span { color:var(--gold); }
.admin-layout { display:grid; grid-template-columns:220px 1fr; flex:1; min-height:calc(100vh - var(--header-h)); }
.admin-sidebar { background:var(--surface); border-right:1px solid var(--border); padding:24px 0; }
.sidebar-item { padding:12px 24px; font-size:14px; cursor:pointer; border-left:3px solid transparent; color:var(--muted); transition:all .2s; display:flex; align-items:center; gap:10px; }
.sidebar-item:hover { color:var(--text); background:rgba(255,255,255,.04); }
.sidebar-item.active { color:var(--gold); border-left-color:var(--gold); background:rgba(212,175,55,.06); }
.admin-content { padding:32px; overflow-y:auto; }
.admin-section { display:none; }
.admin-section.active { display:block; animation:fadeInUp .25s ease; }
.section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:28px; flex-wrap:wrap; gap:12px; }
.section-title { font-family:'Oswald',sans-serif; font-size:24px; font-weight:600; }

/* BUTTONS */
.btn-gold { padding:10px 24px; font-family:'Oswald',sans-serif; font-size:13px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; border:none; background:linear-gradient(135deg,var(--gold),#B8960C); color:var(--dark); font-weight:700; transition:all .2s; border-radius:4px; }
.btn-gold:hover { opacity:.9; transform:translateY(-1px); }
.btn-success { padding:10px 24px; font-family:'Oswald',sans-serif; font-size:13px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; border:none; background:linear-gradient(135deg,var(--green-dark),var(--green)); color:white; border-radius:4px; transition:all .2s; }
.btn-success:hover { opacity:.9; }
.btn-danger { padding:10px 24px; font-family:'Oswald',sans-serif; font-size:13px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; border:none; background:var(--red); color:white; border-radius:4px; transition:all .2s; }
.btn-sm { padding:6px 14px!important; font-size:12px!important; }
.btn-xs { padding:4px 10px!important; font-size:11px!important; }

/* STAT CARDS */
.stats-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:16px; margin-bottom:32px; }
.stat-card { background:var(--card); border:1px solid var(--border); padding:20px; border-radius:4px; }
.stat-card-num { font-family:'Oswald',sans-serif; font-size:36px; font-weight:700; color:var(--gold); }
.stat-card-label { font-size:12px; color:var(--muted); letter-spacing:1px; margin-top:4px; }

/* SESSION LIST */
.session-item { display:flex; align-items:center; gap:10px; padding:16px 18px; border:1px solid var(--border); background:var(--card); border-radius:6px; margin-bottom:10px; flex-wrap:wrap; }
.session-info { flex:1; min-width:200px; font-size:13px; }
.session-code { font-family:'Oswald',sans-serif; font-size:20px; font-weight:600; color:var(--gold); letter-spacing:2px; }
.badge-active { background:rgba(34,197,94,.15); border:1px solid var(--green); color:var(--green); padding:3px 10px; font-size:11px; font-family:'Oswald',sans-serif; letter-spacing:1px; border-radius:3px; }
.badge-closed { background:rgba(200,16,46,.1); border:1px solid var(--red); color:var(--red); padding:3px 10px; font-size:11px; font-family:'Oswald',sans-serif; letter-spacing:1px; border-radius:3px; }

/* LINK BOX */
.link-box { background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:16px; margin-top:10px; }
.link-box-label { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:10px; }
.link-row { display:flex; gap:10px; align-items:center; }
.link-input { flex:1; background:rgba(255,255,255,.05); border:1px solid var(--border); color:var(--gold); padding:10px 14px; font-family:'Oswald',sans-serif; font-size:13px; letter-spacing:1px; border-radius:4px; outline:none; min-width:0; }
.link-input:focus { border-color:var(--gold); }
.btn-copy { padding:10px 18px; font-family:'Oswald',sans-serif; font-size:12px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; border:1px solid var(--gold); background:none; color:var(--gold); transition:all .2s; white-space:nowrap; border-radius:4px; }
.btn-copy:hover { background:var(--gold); color:var(--dark); }
.btn-copy.copied { background:var(--green-dark); border-color:var(--green-dark); color:white; }

/* QUESTION BANK */
.filter-bar { display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; align-items:center; }
.filter-btn { padding:6px 16px; font-family:'Oswald',sans-serif; font-size:12px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; border:1px solid var(--border); background:none; color:var(--muted); transition:all .15s; border-radius:4px; }
.filter-btn.active { border-color:var(--gold); color:var(--gold); }
.filter-btn:hover { border-color:var(--text); color:var(--text); }
.search-input { flex:1; min-width:200px; background:var(--surface); border:1px solid var(--border); color:var(--text); padding:7px 12px; font-family:'Source Sans 3',sans-serif; font-size:14px; border-radius:4px; }
.search-input:focus { outline:none; border-color:var(--gold); }
.qb-item { background:var(--card); border:1px solid var(--border); padding:14px 18px; display:flex; align-items:flex-start; gap:14px; transition:all .2s; border-radius:4px; margin-bottom:8px; animation:slideLeft .2s ease; }
.qb-item:hover { border-color:#3a3a4a; }
.qb-check { width:20px; height:20px; border:1px solid var(--border); cursor:pointer; flex-shrink:0; margin-top:2px; display:flex; align-items:center; justify-content:center; transition:all .2s; border-radius:3px; }
.qb-check.checked { background:var(--blue-mid); border-color:var(--blue-mid); }
.qb-check.checked::after { content:'✓'; font-size:12px; color:#fff; }
.qb-info { flex:1; }
.qb-text { font-size:14px; line-height:1.5; margin-bottom:6px; }
.qb-tags { display:flex; gap:6px; flex-wrap:wrap; }
.qb-tag { font-size:10px; letter-spacing:1px; text-transform:uppercase; padding:2px 8px; border:1px solid var(--border); color:var(--muted); border-radius:20px; }
.qb-tag.tf { border-color:var(--orange); color:var(--orange); }
.qb-tag.mc { border-color:var(--blue-light); color:var(--blue-light); }
.qb-tag.sc { border-color:var(--green); color:var(--green); }
.qb-actions { display:flex; gap:6px; flex-shrink:0; }
.btn-icon { width:30px; height:30px; border:1px solid var(--border); background:none; color:var(--muted); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:13px; transition:all .15s; border-radius:4px; }
.btn-icon:hover { border-color:var(--red); color:var(--red); }
.btn-icon.edit:hover { border-color:var(--gold); color:var(--gold); }

/* CONFIG */
.config-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px; }
.config-item { background:var(--card); border:1px solid var(--border); padding:20px; border-radius:6px; }
.config-label { font-size:12px; color:var(--muted); letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; }
.config-input { width:100%; background:var(--surface); border:1px solid var(--border); color:var(--text); padding:8px 12px; font-family:'Source Sans 3',sans-serif; font-size:15px; border-radius:4px; }
.config-input:focus { outline:none; border-color:var(--gold); }
textarea.config-input { resize:vertical; min-height:80px; }
.form-field { margin-bottom:16px; }
.form-label { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:6px; display:block; }
.form-input { width:100%; background:var(--surface); border:1px solid var(--border); color:var(--text); padding:10px 14px; font-family:'Source Sans 3',sans-serif; font-size:15px; border-radius:4px; }
.form-input:focus { outline:none; border-color:var(--gold); }
textarea.form-input { resize:vertical; min-height:80px; }
.option-row { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.option-label-badge { background:var(--blue-mid); color:white; width:26px; height:26px; border-radius:5px; display:flex; align-items:center; justify-content:center; font-family:'Oswald',sans-serif; font-weight:700; font-size:13px; flex-shrink:0; }

/* IMPORT */
.import-zone { border:2px dashed var(--border); border-radius:8px; padding:30px; text-align:center; cursor:pointer; transition:all .2s; background:var(--surface); margin-bottom:16px; }
.import-zone:hover { border-color:var(--gold); }
.import-zone input { display:none; }
.bulk-textarea { width:100%; min-height:130px; font-family:'Courier New',monospace; font-size:13px; padding:12px; border:1px solid var(--border); border-radius:6px; resize:vertical; background:var(--surface); color:var(--text); line-height:1.6; margin-top:8px; }
.bulk-textarea:focus { outline:none; border-color:var(--gold); }

/* RESULTS TABLE */
.results-table { width:100%; border-collapse:collapse; font-size:14px; }
.results-table th { text-align:left; padding:10px 14px; font-family:'Oswald',sans-serif; font-size:12px; letter-spacing:2px; color:var(--muted); text-transform:uppercase; border-bottom:1px solid var(--border); background:var(--surface); }
.results-table td { padding:10px 14px; border-bottom:1px solid rgba(255,255,255,.04); }
.badge-pass { color:var(--green); font-family:'Oswald',sans-serif; font-weight:600; }
.badge-fail { color:var(--red); font-family:'Oswald',sans-serif; font-weight:600; }

/* EXAM SCREEN */
#screen-exam { background:var(--dark); }
.exam-header { background:linear-gradient(90deg,#001845,#003DA5 50%,#1a7fd4); padding:0 20px; height:70px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; box-shadow:0 4px 20px rgba(0,0,0,.3); }
.exam-header-left { display:flex; align-items:center; gap:14px; }
.exam-logo-sm { width:46px; height:46px; background:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Oswald',sans-serif; font-size:18px; font-weight:900; color:#003a7d; flex-shrink:0; }
.exam-title-block h1 { font-family:'Oswald',sans-serif; font-size:15px; font-weight:700; line-height:1.2; color:white; }
.exam-title-block p { font-size:10px; opacity:.8; color:white; }
.exam-meta { display:flex; align-items:center; gap:16px; }
.meta-item { display:flex; flex-direction:column; align-items:center; }
.meta-value { font-family:'Oswald',sans-serif; font-size:14px; font-weight:700; color:white; }
.meta-label { font-size:9px; opacity:.75; text-transform:uppercase; color:white; }
.timer-display { background:rgba(255,255,255,.15); border:2px solid rgba(255,255,255,.3); border-radius:8px; padding:6px 14px; text-align:center; min-width:110px; }
.timer-display .time-val { font-family:'Oswald',sans-serif; font-size:20px; font-weight:700; letter-spacing:2px; color:white; }
.timer-display.urgent { background:rgba(200,16,46,.3); border-color:#fca5a5; animation:pulse 1s infinite; }
.progress-bar-wrap { height:4px; background:rgba(255,255,255,.1); }
.progress-bar-fill { height:100%; background:linear-gradient(90deg,var(--blue-mid),var(--green)); transition:width .3s; }
.exam-body { flex:1; display:flex; overflow:hidden; }
.exam-sidebar { width:220px; background:var(--surface); border-right:1px solid var(--border); padding:20px; overflow-y:auto; flex-shrink:0; }
.sidebar-nav-title { font-family:'Oswald',sans-serif; font-size:11px; letter-spacing:3px; color:var(--muted); text-transform:uppercase; margin-bottom:14px; }
.q-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:5px; }
.q-btn { width:34px; height:34px; border:1px solid var(--border); background:var(--card); color:var(--muted); font-family:'Oswald',sans-serif; font-size:13px; cursor:pointer; transition:all .15s; display:flex; align-items:center; justify-content:center; border-radius:3px; }
.q-btn.answered { background:rgba(0,90,181,.3); border-color:var(--blue-mid); color:white; }
.q-btn.current { background:var(--red); border-color:var(--red); color:white; }
.q-btn:hover { transform:scale(1.12); border-color:var(--gold); }
.sidebar-legend { margin-top:18px; display:flex; flex-direction:column; gap:7px; }
.legend-item { display:flex; align-items:center; gap:8px; font-size:12px; color:var(--muted); }
.legend-dot { width:14px; height:14px; border:1px solid; flex-shrink:0; border-radius:2px; }
.legend-dot.answered { background:rgba(0,90,181,.3); border-color:var(--blue-mid); }
.legend-dot.current { background:var(--red); border-color:var(--red); }
.legend-dot.empty { background:var(--card); border-color:var(--border); }
.unanswered-count { margin-top:20px; padding-top:14px; border-top:1px solid var(--border); font-size:12px; color:var(--muted); }
.exam-main { flex:1; padding:24px; overflow-y:auto; display:flex; flex-direction:column; }
.progress-info { display:flex; justify-content:space-between; margin-bottom:12px; }
.progress-info span { font-size:12px; color:var(--muted); }
.question-card { background:white; border-radius:10px; border:1px solid #e2e8f0; flex:1; box-shadow:0 2px 10px rgba(0,0,0,.05); overflow:hidden; color:#1e293b; animation:fadeInUp .25s ease; }
.question-card-header { padding:14px 18px; border-bottom:1px solid #e2e8f0; display:flex; align-items:center; gap:10px; background:#f8fafc; }
.q-type-pill { background:linear-gradient(135deg,#003a7d,#005ab5); color:white; padding:3px 12px; border-radius:20px; font-family:'Oswald',sans-serif; font-size:11px; font-weight:700; letter-spacing:1px; }
.q-type-pill.tf { background:linear-gradient(135deg,#b45309,var(--orange)); }
.q-type-pill.mc { background:linear-gradient(135deg,#1d4ed8,#3b82f6); }
.q-points-pill { margin-left:auto; font-family:'Oswald',sans-serif; font-size:12px; font-weight:700; color:#005ab5; background:#eff6ff; padding:3px 10px; border-radius:20px; }
.question-card-body { padding:24px; }
.question-text { font-size:16px; line-height:1.6; color:#1e293b; margin-bottom:20px; font-weight:500; }
.options-list { display:flex; flex-direction:column; gap:10px; }
.option-item { display:flex; align-items:center; gap:12px; padding:13px 16px; border:2px solid #e2e8f0; border-radius:8px; cursor:pointer; transition:all .15s; background:white; color:#1e293b; animation:slideLeft .2s ease both; }
.option-item:hover { border-color:#1a7fd4; background:#f0f9ff; }
.option-item.selected { border-color:#005ab5; background:#eff6ff; }
.option-item.selected .option-letter { background:#005ab5; color:white; }
.option-letter { width:32px; height:32px; background:#e2e8f0; border-radius:6px; display:flex; align-items:center; justify-content:center; font-family:'Oswald',sans-serif; font-size:14px; font-weight:700; color:#1e293b; flex-shrink:0; transition:all .15s; }
.option-text { font-size:15px; line-height:1.5; }
.nav-buttons { display:flex; align-items:center; justify-content:space-between; margin-top:16px; gap:10px; flex-wrap:wrap; }
.btn-nav-light { padding:10px 22px; border:2px solid #e2e8f0; background:white; color:#64748b; font-family:'Oswald',sans-serif; font-size:13px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; border-radius:8px; transition:all .2s; }
.btn-nav-light:hover { border-color:#005ab5; color:#005ab5; }
.btn-finish { padding:10px 28px; border:none; background:linear-gradient(135deg,#16a34a,#22c55e); color:white; font-family:'Oswald',sans-serif; font-size:13px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; border-radius:8px; transition:all .2s; animation:pulseGreen 2s ease-in-out infinite; }
.btn-finish:hover { animation:none; transform:translateY(-2px); box-shadow:0 8px 24px rgba(22,163,74,.5); }

/* RESULTS */
#screen-results { background:var(--dark); align-items:center; justify-content:center; padding:40px 20px; }
.results-card { background:white; border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.4); width:100%; max-width:520px; overflow:hidden; color:#1e293b; animation:scaleIn .4s cubic-bezier(.22,.9,.44,1); }
.results-header { padding:32px; text-align:center; color:white; }
.results-header.pass { background:linear-gradient(135deg,#064e3b,#16a34a); }
.results-header.fail { background:linear-gradient(135deg,#7f1d1d,#b91c1c); }
.result-icon { font-size:48px; margin-bottom:12px; }
.result-score-big { font-family:'Oswald',sans-serif; font-size:56px; font-weight:700; line-height:1; }
.result-verdict { font-family:'Oswald',sans-serif; font-size:22px; font-weight:700; letter-spacing:2px; margin-top:6px; }
.results-body { padding:24px; }
.result-breakdown { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:20px; }
.breakdown-item { text-align:center; padding:14px; background:#f8fafc; border-radius:8px; border:1px solid #e2e8f0; }
.breakdown-val { font-family:'Oswald',sans-serif; font-size:26px; font-weight:700; color:#1e293b; }
.breakdown-label { font-size:11px; color:#94a3b8; text-transform:uppercase; letter-spacing:1px; margin-top:4px; }
.detail-item { display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid #e2e8f0; font-size:14px; }
.detail-item:last-child { border-bottom:none; }
.detail-item strong { color:#003a7d; }
.result-actions { display:flex; gap:10px; justify-content:center; margin-top:20px; flex-wrap:wrap; }
.btn-result-primary { padding:12px 28px; background:linear-gradient(135deg,#003a7d,#1a7fd4); color:white; border:none; border-radius:8px; font-family:'Oswald',sans-serif; font-size:14px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; transition:all .2s; }
.btn-result-secondary { padding:12px 28px; background:white; color:#003a7d; border:2px solid #003a7d; border-radius:8px; font-family:'Oswald',sans-serif; font-size:14px; letter-spacing:1px; text-transform:uppercase; cursor:pointer; transition:all .2s; }

/* MODAL */
.modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.8); z-index:9999; align-items:center; justify-content:center; padding:20px; }
.modal-overlay.open { display:flex; }
.modal-box { border:1px solid var(--border); padding:32px; width:90%; max-width:480px; max-height:90vh; overflow-y:auto; border-radius:10px; animation:scaleIn .28s cubic-bezier(.22,.9,.44,1); }
.modal-box.dark { background:var(--card); color:var(--text); }
.modal-box.light { background:white; color:#1e293b; border:none; }
.modal-title { font-family:'Oswald',sans-serif; font-size:20px; margin-bottom:20px; }
.modal-footer { display:flex; gap:10px; justify-content:flex-end; margin-top:20px; }
.modal-header { font-family:'Oswald',sans-serif; font-size:18px; margin-bottom:16px; color:#003a7d; }
.hidden { display:none!important; }

/* TOAST */
#uni-toast { position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(80px); background:#1e293b; color:#fff; padding:12px 24px; border-radius:30px; font-size:14px; font-weight:600; z-index:10001; transition:transform .3s,opacity .3s; opacity:0; pointer-events:none; white-space:nowrap; }

/* GFORM */
.gform-section { background:var(--card); border:1px solid var(--border); padding:24px; border-radius:6px; margin-bottom:24px; }
.gform-title { font-family:'Oswald',sans-serif; font-size:16px; color:var(--gold); margin-bottom:16px; }
.gform-info { background:rgba(0,90,181,.1); border:1px solid rgba(0,90,181,.3); border-radius:6px; padding:14px; font-size:13px; color:#93c5fd; line-height:1.7; }
.gform-info code { background:rgba(255,255,255,.1); padding:2px 6px; border-radius:3px; font-family:monospace; }

@media(max-width:900px) { .admin-layout{grid-template-columns:1fr} .admin-sidebar{display:none} .config-grid{grid-template-columns:1fr} }
@media(max-width:768px) { .exam-sidebar{display:none} .exam-main{padding:14px} .result-breakdown{grid-template-columns:repeat(3,1fr)} }
@media(max-width:500px) { .result-breakdown{grid-template-columns:1fr} }
</style>
</head>
<body>

<!-- LANDING -->
<div id="screen-landing" class="screen active">
  <div class="landing-inner">
    <div class="landing-badge">IWUF — Wushu Sanda · Règlement 2024</div>
    <h1 class="landing-title"><span class="r">SANDA</span> <span class="b">ARBITRE</span><br>CERTIFICATION</h1>
    <p class="landing-sub">Examen Théorique · Règlement 2024 · Certification B / A · Officiel IWUF</p>
    <div class="divider-line"></div>
    <div class="btn-group">
      <button class="btn-primary" onclick="showCandidateLogin()">▶ COMMENCER L'EXAMEN</button>
      <button class="btn-secondary" onclick="showScreen('admin-login')">⚙ ADMINISTRATION</button>
    </div>
    <div class="stats-row">
      <div class="stat-item"><div class="stat-num" id="landing-q-count">0</div><div class="stat-label">Questions</div></div>
      <div class="stat-item"><div class="stat-num" id="landing-duration">60</div><div class="stat-label">Minutes</div></div>
      <div class="stat-item"><div class="stat-num" id="landing-pass">60%</div><div class="stat-label">Seuil réussite</div></div>
      <div class="stat-item"><div class="stat-num" id="landing-sessions">0</div><div class="stat-label">Sessions</div></div>
    </div>
  </div>
</div>

<!-- CANDIDATE LOGIN -->
<div id="screen-candidate-login" class="screen" style="align-items:center;justify-content:center;background:linear-gradient(135deg,#001f5b,#003a7d 40%,#005ab5 80%,#1a7fd4)">
  <div class="login-card">
    <div class="login-card-header">
      <div class="login-logo">武</div>
      <h2>IWUF — Évaluation des Arbitres</h2>
      <p>Examen Théorique · Accès Candidat</p>
    </div>
    <div class="login-card-body">
      <div id="prefilled-notice" class="info-box success" style="display:none">
        ✅ Code de session pré-rempli depuis votre lien d'invitation.
      </div>
      <div class="info-box info">
        ℹ️ Entrez le <strong>code de session</strong> fourni par l'administrateur et votre nom complet.
      </div>
      <div class="fg">
        <label>Code de Session</label>
        <input type="text" id="cand-session-code" placeholder="Ex: SESSION-ABC123"
          style="font-size:16px;text-align:center;font-weight:600;letter-spacing:1px"
          autocomplete="off" oninput="this.value=this.value.toUpperCase()"
          onkeypress="if(event.key==='Enter')document.getElementById('cand-name').focus()">
      </div>
      <div class="fg">
        <label>Votre Nom Complet</label>
        <input type="text" id="cand-name" placeholder="Nom Prénom" autocomplete="off"
          onkeypress="if(event.key==='Enter')startExam()">
      </div>
      <div id="cand-error" class="info-box error" style="display:none"></div>
      <button class="btn-blue" onclick="startExam()">Commencer l'Examen ▶</button>
      <button class="btn-link" onclick="showScreen('landing')">← Retour à l'accueil</button>
      <div class="info-box warning" style="margin-top:14px">
        ⚠️ Assurez-vous d'avoir un code de session valide. Contactez l'administrateur si vous n'en avez pas.
      </div>
    </div>
  </div>
</div>

<!-- ADMIN LOGIN -->
<div id="screen-admin-login" class="screen" style="align-items:center;justify-content:center;background:var(--dark)">
  <div style="background:var(--card);border:1px solid var(--border);padding:40px;width:360px;text-align:center;border-radius:8px;animation:scaleIn .35s ease">
    <div style="font-family:'Oswald',sans-serif;font-size:22px;margin-bottom:8px;color:var(--gold)">⚙ ACCÈS ADMINISTRATEUR</div>
    <p style="font-size:13px;color:var(--muted);margin-bottom:28px">Session sécurisée · Non accessible aux candidats</p>
    <div class="form-field">
      <label class="form-label">Identifiant</label>
      <input type="text" class="form-input" id="al-user" placeholder="admin" onkeypress="if(event.key==='Enter')doAdminLogin()">
    </div>
    <div class="form-field">
      <label class="form-label">Mot de passe</label>
      <input type="password" class="form-input" id="al-pass" placeholder="••••••••" onkeypress="if(event.key==='Enter')doAdminLogin()">
    </div>
    <button class="btn-gold" style="width:100%;margin-top:8px" onclick="doAdminLogin()">CONNEXION</button>
    <div class="login-error" id="al-error">Identifiants incorrects</div>
    <button class="btn-secondary" style="width:100%;margin-top:14px" onclick="showScreen('landing')">← Retour</button>
    <div style="margin-top:16px;font-size:11px;color:var(--muted)">Démo : admin / sanda2024</div>
  </div>
</div>

<!-- ADMIN PANEL -->
<div id="screen-admin" class="screen">
  <div class="admin-top-bar">
    <div class="brand">IWUF <span>ADMIN</span></div>
    <div style="display:flex;gap:10px">
      <button class="btn-gold btn-sm" onclick="showCandidateLogin()">▶ Accès Arbitre</button>
      <button class="btn-secondary btn-sm" onclick="showScreen('landing')">← Accueil</button>
    </div>
  </div>
  <div class="admin-layout">
    <div class="admin-sidebar">
      <div class="sidebar-item active" onclick="adminNav('dashboard',this)">📊 Tableau de bord</div>
      <div class="sidebar-item" onclick="adminNav('sessions',this)">🔑 Sessions &amp; Liens</div>
      <div class="sidebar-item" onclick="adminNav('questions',this)">📝 Banque de questions</div>
      <div class="sidebar-item" onclick="adminNav('add',this)">➕ Ajouter question</div>
      <div class="sidebar-item" onclick="adminNav('import',this)">📥 Import CSV</div>
      <div class="sidebar-item" onclick="adminNav('bulk',this)">⚡ Ajout rapide</div>
      <div class="sidebar-item" onclick="adminNav('config',this)">⚙ Configuration</div>
      <div class="sidebar-item" onclick="adminNav('results',this)">🏆 Résultats</div>
      <div class="sidebar-item" onclick="adminNav('analysis',this)">📈 Analyse Sessions</div>
      <div class="sidebar-item" onclick="adminNav('publish',this)">🌐 Google Sites</div>
    </div>
    <div class="admin-content">

      <!-- DASHBOARD -->
      <div id="admin-dashboard" class="admin-section active">
        <div class="section-header"><h2 class="section-title">Tableau de bord</h2></div>
        <div class="stats-cards">
          <div class="stat-card"><div class="stat-card-num" id="dash-total-q">0</div><div class="stat-card-label">Questions</div></div>
          <div class="stat-card"><div class="stat-card-num" id="dash-sessions">0</div><div class="stat-card-label">Sessions</div></div>
          <div class="stat-card"><div class="stat-card-num" id="dash-results">0</div><div class="stat-card-label">Examens passés</div></div>
          <div class="stat-card"><div class="stat-card-num" id="dash-pass-rate">—</div><div class="stat-card-label">Taux réussite</div></div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);padding:20px;margin-bottom:16px;border-radius:6px">
          <div style="font-family:'Oswald',sans-serif;font-size:16px;margin-bottom:12px;color:var(--gold)">Répartition par type</div>
          <div id="type-breakdown" style="font-size:14px;color:var(--muted);line-height:2"></div>
        </div>
        <div style="background:var(--card);border:1px solid var(--border);padding:20px;border-radius:6px">
          <div style="font-family:'Oswald',sans-serif;font-size:16px;margin-bottom:12px;color:var(--gold)">Répartition par catégorie</div>
          <div id="chapter-breakdown" style="font-size:14px;color:var(--muted);line-height:2"></div>
        </div>
      </div>

      <!-- SESSIONS & LINKS -->
      <div id="admin-sessions" class="admin-section">
        <div class="section-header">
          <h2 class="section-title">Sessions &amp; Liens d'Accès</h2>
          <button class="btn-gold" onclick="createNewSession()">+ Nouvelle Session</button>
        </div>
        <div class="info-box info" style="margin-bottom:20px">
          <strong>📋 Comment envoyer un lien à un candidat :</strong><br>
          1. Créez une session ci-dessous → un <strong>code unique</strong> + un <strong>lien direct</strong> sont générés<br>
          2. Copiez le <strong>lien candidat</strong> et envoyez-le par email / WhatsApp / SMS<br>
          3. Le candidat clique → le code est <strong>pré-rempli automatiquement</strong> → il entre son nom → l'examen commence<br>
          4. Les résultats apparaissent ici dans l'onglet <strong>🏆 Résultats</strong> (même navigateur)
        </div>
        <div id="session-list"><div style="text-align:center;color:var(--muted);padding:30px;background:var(--card);border:1px solid var(--border);border-radius:6px">Aucune session. Cliquez sur "+ Nouvelle Session".</div></div>
      </div>

      <!-- QUESTIONS -->
      <div id="admin-questions" class="admin-section">
        <div class="section-header">
          <h2 class="section-title">Banque de Questions</h2>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <span style="font-size:13px;color:var(--muted)">Sélect.: <strong style="color:var(--gold)" id="selected-count">0</strong></span>
            <button class="btn-secondary btn-sm" onclick="selectAllQ()">☑ Tout</button>
            <button class="btn-secondary btn-sm" onclick="deselectAllQ()">☐ Aucun</button>
            <button class="btn-gold btn-sm" onclick="adminNav('add',document.querySelector('.sidebar-item:nth-child(4)'))">+ Ajouter</button>
          </div>
        </div>
        <div class="filter-bar">
          <button class="filter-btn active" onclick="filterQB('all',this)">Toutes</button>
          <button class="filter-btn" onclick="filterQB('tf',this)">Vrai/Faux</button>
          <button class="filter-btn" onclick="filterQB('mc',this)">Choix multiple</button>
          <button class="filter-btn" onclick="filterQB('sc',this)">Choix simple</button>
          <input class="search-input" id="qb-search" placeholder="🔍 Rechercher..." oninput="renderQB()">
        </div>
        <div id="question-bank-list"></div>
      </div>

      <!-- ADD QUESTION -->
      <div id="admin-add" class="admin-section">
        <div class="section-header"><h2 class="section-title" id="add-title">Ajouter une Question</h2></div>
        <div class="config-grid" style="gap:12px;margin-bottom:16px">
          <div>
            <div class="config-label">Type</div>
            <select class="config-input" id="new-q-type" onchange="updateAnswerFields()">
              <option value="sc">Choix simple</option>
              <option value="mc">Choix multiple</option>
              <option value="tf">Vrai / Faux</option>
            </select>
          </div>
          <div>
            <div class="config-label">Catégorie</div>
            <select class="config-input" id="new-q-chapter">
              <option>Règlement</option><option>Technique</option><option>Arbitrage</option>
              <option>Officials</option><option>Équipement</option><option>Méthodes &amp; Notation</option>
              <option>Fouls &amp; Pénalités</option><option>Généralités</option><option>Sécurité</option>
            </select>
          </div>
          <div>
            <div class="config-label">Points</div>
            <input type="number" class="config-input" id="new-q-points" value="1" min="0.5" max="10" step="0.5">
          </div>
        </div>
        <div class="form-field">
          <label class="form-label">Texte de la question</label>
          <textarea class="form-input" id="new-q-text" rows="3" placeholder="Entrez le texte de la question..."></textarea>
        </div>
        <div id="answer-fields"></div>
        <div style="display:flex;gap:12px;margin-top:20px">
          <button class="btn-gold" onclick="saveQuestion()">💾 Enregistrer</button>
          <button class="btn-secondary" onclick="resetAddForm()">✕ Effacer</button>
        </div>
      </div>

      <!-- IMPORT CSV -->
      <div id="admin-import" class="admin-section">
        <div class="section-header"><h2 class="section-title">Import CSV</h2></div>
        <div style="background:var(--card);border:1px solid var(--border);padding:20px;border-radius:6px;margin-bottom:20px">
          <div style="font-family:'Oswald',sans-serif;font-size:14px;color:var(--gold);margin-bottom:10px">📋 Format (séparateur point-virgule)</div>
          <code style="font-size:12px;color:var(--muted);background:var(--surface);padding:10px;border-radius:4px;display:block">Catégorie;Question;OptionA;OptionB;OptionC;OptionD;Réponse(A/B/C/D);Points</code>
        </div>
        <div class="import-zone" id="import-zone">
          <div style="font-size:36px;margin-bottom:8px">📂</div>
          <div style="font-weight:600;font-size:14px;color:var(--text)">Cliquez ou déposez un fichier CSV</div>
          <input type="file" id="csv-file-input" accept=".csv,.txt">
        </div>
        <textarea id="import-textarea" class="bulk-textarea" placeholder="Ou collez le contenu CSV ici..."></textarea>
        <button class="btn-gold" style="margin-top:10px" onclick="parseCSV()">📥 Importer</button>
        <div id="import-result" style="margin-top:14px"></div>
      </div>

      <!-- BULK ADD -->
      <div id="admin-bulk" class="admin-section">
        <div class="section-header"><h2 class="section-title">Ajout Rapide</h2></div>
        <div style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;margin-bottom:16px">
          <div><div class="config-label">Catégorie</div><select class="config-input" id="bulk-cat" style="width:auto"><option>Règlement</option><option>Technique</option><option>Arbitrage</option><option>Officials</option><option>Équipement</option><option>Méthodes &amp; Notation</option><option>Fouls &amp; Pénalités</option><option>Généralités</option></select></div>
          <div><div class="config-label">Points</div><input type="number" class="config-input" id="bulk-pts" value="1" min="0.5" max="10" step="0.5" style="width:80px"></div>
          <div><div class="config-label">Nombre</div><input type="number" class="config-input" id="bulk-count" value="5" min="1" max="50" style="width:80px"></div>
          <button class="btn-gold" onclick="generateBulkForm()">⚡ Générer</button>
        </div>
        <div id="bulk-container" style="max-height:450px;overflow-y:auto"><div style="text-align:center;color:var(--muted);padding:30px">Cliquez sur Générer.</div></div>
        <div id="bulk-actions" style="display:none;gap:12px;margin-top:14px">
          <button class="btn-success" onclick="saveBulkQuestions()">💾 Tout enregistrer</button>
          <button class="btn-secondary" onclick="clearBulkForm()">Effacer</button>
        </div>
      </div>

      <!-- CONFIG -->
      <div id="admin-config" class="admin-section">
        <div class="section-header"><h2 class="section-title">Configuration</h2></div>
        <div class="config-grid">
          <div class="config-item"><div class="config-label">Titre de l'examen</div><input type="text" class="config-input" id="cfg-title"></div>
          <div class="config-item"><div class="config-label">Durée (minutes)</div><input type="number" class="config-input" id="cfg-duration" min="5" max="240"></div>
          <div class="config-item"><div class="config-label">Questions par examen</div><input type="number" class="config-input" id="cfg-nquestions" min="5" max="200"></div>
          <div class="config-item"><div class="config-label">Seuil de réussite (%)</div><input type="number" class="config-input" id="cfg-pass" min="1" max="100"></div>
          <div class="config-item"><div class="config-label">Mélanger les questions</div><select class="config-input" id="cfg-shuffle"><option value="1">Oui (recommandé)</option><option value="0">Non</option></select></div>
          <div class="config-item"><div class="config-label">Nouveau mot de passe admin</div><input type="password" class="config-input" id="cfg-pass-admin" placeholder="Laisser vide = inchangé"></div>
        </div>
        <button class="btn-gold" onclick="saveConfig()">💾 Sauvegarder</button>
      </div>

      <!-- RESULTS -->
      <div id="admin-results" class="admin-section">
        <div class="section-header">
          <h2 class="section-title">Résultats des Candidats</h2>
          <div style="display:flex;gap:10px">
            <button class="btn-success btn-sm" onclick="exportCSV()">📥 CSV</button>
            <button class="btn-danger btn-sm" onclick="clearAllResults()">🗑 Effacer</button>
          </div>
        </div>
        <div class="stats-cards" style="grid-template-columns:repeat(4,1fr)">
          <div class="stat-card"><div class="stat-card-num" id="res-total">0</div><div class="stat-card-label">Total</div></div>
          <div class="stat-card"><div class="stat-card-num" id="res-pass" style="color:var(--green)">0</div><div class="stat-card-label">Réussites</div></div>
          <div class="stat-card"><div class="stat-card-num" id="res-fail" style="color:var(--red)">0</div><div class="stat-card-label">Échecs</div></div>
          <div class="stat-card"><div class="stat-card-num" id="res-avg">—</div><div class="stat-card-label">Moyenne</div></div>
        </div>
        <div style="overflow-x:auto">
