<script>
// ============================================================
// DATA
// ============================================================
let questionBank = [];
let activeSessions = {};
let allResults = [];
let examConfig = { duration:60, nQuestions:30, passThreshold:60, shuffle:true, title:'IWUF — Examen Arbitrage Sanda 2024', adminPass:'sanda2024' };
let gFormsConfig = { url:'', nameId:'', scoreId:'', sessionId:'' };

let currentExam = null;
let timerInterval = null;
let currentFilter = 'all';
let editingQIndex = -1;
let selectedForExam = new Set();
let _uniResolve = null;

// ============================================================
// INITIALISATION
// ============================================================
window.addEventListener('DOMContentLoaded', () => {
  loadFromStorage();
  if (!questionBank.length) loadDefaultQuestions();
  selectedForExam = new Set(questionBank.map(q => q.id));
  updateLandingStats();
  setupImportZone();
  updateAnswerFields();

  // ⭐⭐⭐ CORRECTION : Lecture du code session depuis l'URL (FONCTIONNE PARFAITEMENT) ⭐⭐⭐
  function extractSessionCodeFromUrl() {
    // Méthode 1 : Paramètre d'URL standard ?session=CODE
    const urlParams = new URLSearchParams(window.location.search);
    let code = urlParams.get('session') || urlParams.get('s');
    if (code) return code.toUpperCase();
    
    // Méthode 2 : Hash #session=CODE
    if (window.location.hash) {
      const hash = window.location.hash.substring(1);
      // Format #session=CODE
      if (hash.includes('=')) {
        const hashParams = new URLSearchParams(hash);
        code = hashParams.get('session') || hashParams.get('s');
        if (code) return code.toUpperCase();
      }
      // Format #SESSION-XXXXXX (hash direct)
      if (hash.toUpperCase().startsWith('SESSION-')) {
        return hash.toUpperCase();
      }
    }
    return null;
  }
  
  // Appliquer le code session s'il existe
  const sessionCode = extractSessionCodeFromUrl();
  if (sessionCode) {
    setTimeout(() => {
      showScreen('candidate-login');
      const sessionInput = document.getElementById('cand-session-code');
      const notice = document.getElementById('prefilled-notice');
      if (sessionInput) {
        sessionInput.value = sessionCode;
        if (notice) notice.style.display = 'block';
        const nameInput = document.getElementById('cand-name');
        if (nameInput) nameInput.focus();
      }
    }, 50);
  }

  // Écouteur pour les changements de hash
  window.addEventListener('hashchange', () => {
    const newCode = extractSessionCodeFromUrl();
    if (newCode) {
      showScreen('candidate-login');
      const sessionInput = document.getElementById('cand-session-code');
      const notice = document.getElementById('prefilled-notice');
      if (sessionInput) {
        sessionInput.value = newCode;
        if (notice) notice.style.display = 'block';
      }
    }
  });
});

// ============================================================
// STORAGE
// ============================================================
function loadFromStorage() {
  try {
    const q = localStorage.getItem('iwuf_qbank'); if(q) questionBank = JSON.parse(q);
    const s = localStorage.getItem('iwuf_sessions'); if(s) activeSessions = JSON.parse(s);
    const r = localStorage.getItem('iwuf_results'); if(r) allResults = JSON.parse(r);
    const c = localStorage.getItem('iwuf_config'); if(c) examConfig = {...examConfig,...JSON.parse(c)};
    const g = localStorage.getItem('iwuf_gforms'); if(g) gFormsConfig = {...gFormsConfig,...JSON.parse(g)};
  } catch(e) {}
}

function saveToStorage() {
  try {
    localStorage.setItem('iwuf_qbank', JSON.stringify(questionBank));
    localStorage.setItem('iwuf_sessions', JSON.stringify(activeSessions));
    localStorage.setItem('iwuf_results', JSON.stringify(allResults));
    localStorage.setItem('iwuf_config', JSON.stringify(examConfig));
    localStorage.setItem('iwuf_gforms', JSON.stringify(gFormsConfig));
  } catch(e) {}
}

// ============================================================
// SCREEN & MODALS
// ============================================================
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const el = document.getElementById('screen-' + id);
  if (el) el.classList.add('active');
}

function showCandidateLogin() { showScreen('candidate-login'); }

function openModal(id) { 
  const el = document.getElementById(id); 
  el.classList.remove('hidden'); 
  el.style.display='flex'; 
  el.classList.add('open'); 
}

function closeModal(id) { 
  const el = document.getElementById(id); 
  el.classList.add('hidden'); 
  el.style.display=''; 
  el.classList.remove('open'); 
}

function uniConfirm(msg, icon) {
  return new Promise(resolve => {
    _uniResolve = resolve;
    document.getElementById('uni-msg').innerHTML = msg;
    document.getElementById('uni-icon').textContent = icon || '⚠️';
    openModal('uni-confirm-modal');
  });
}

function uniResolve(val) { 
  closeModal('uni-confirm-modal'); 
  if(_uniResolve){_uniResolve(val);_uniResolve=null;} 
}

function showToast(msg, color) {
  const t = document.getElementById('uni-toast');
  t.textContent = msg;
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._t);
  t._t = setTimeout(() => { 
    t.style.opacity = '0'; 
    t.style.transform = 'translateX(-50%) translateY(80px)'; 
  }, 3000);
}

function copyText(text, btnEl) {
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
  } else {
    fallbackCopy(text);
  }
  if (btnEl) { 
    const orig = btnEl.textContent; 
    btnEl.textContent = '✅ Copié !'; 
    btnEl.classList.add('copied'); 
    setTimeout(() => { btnEl.textContent = orig; btnEl.classList.remove('copied'); }, 2200); 
  }
}

function fallbackCopy(text) {
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  document.execCommand('copy');
  document.body.removeChild(ta);
}

// ============================================================
// LANDING STATS
// ============================================================
function updateLandingStats() {
  document.getElementById('landing-q-count').textContent = questionBank.length;
  document.getElementById('landing-duration').textContent = examConfig.duration;
  document.getElementById('landing-pass').textContent = examConfig.passThreshold + '%';
  document.getElementById('landing-sessions').textContent = Object.keys(activeSessions).length;
}

// ============================================================
// ADMIN LOGIN
// ============================================================
function doAdminLogin() {
  const u = document.getElementById('al-user').value;
  const p = document.getElementById('al-pass').value;
  const err = document.getElementById('al-error');
  if (u === 'admin' && p === examConfig.adminPass) {
    err.style.display = 'none';
    showScreen('admin');
    refreshAdmin();
  } else {
    err.style.display = 'block';
    err.textContent = 'Identifiants incorrects. Démo : admin / sanda2024';
  }
}

function refreshAdmin() {
  updateDashboard(); 
  renderQB(); 
  renderSessions(); 
  renderAdminResults(); 
  syncConfigUI(); 
  syncGFormsUI();
}

// ============================================================
// ADMIN NAVIGATION
// ============================================================
function adminNav(section, el) {
  document.querySelectorAll('.sidebar-item').forEach(s => s.classList.remove('active'));
  if (el) el.classList.add('active');
  document.querySelectorAll('.admin-section').forEach(s => s.classList.remove('active'));
  const target = document.getElementById('admin-' + section);
  if (target) target.classList.add('active');
  if (section === 'questions') renderQB();
  if (section === 'results') renderAdminResults();
  if (section === 'analysis') { populateSessionSelect(); renderAnalysis(); }
  if (section === 'sessions') renderSessions();
}

// ============================================================
// DASHBOARD
// ============================================================
function updateDashboard() {
  document.getElementById('dash-total-q').textContent = questionBank.length;
  document.getElementById('dash-sessions').textContent = Object.keys(activeSessions).length;
  document.getElementById('dash-results').textContent = allResults.length;
  const t = allResults.length, p = allResults.filter(r=>r.passed).length;
  document.getElementById('dash-pass-rate').textContent = t ? Math.round(p/t*100)+'%' : '—';
  const types={tf:0,sc:0,mc:0}, cats={};
  questionBank.forEach(q => { types[q.type||'sc']++; const c=q.chapter||q.category||'Autre'; cats[c]=(cats[c]||0)+1; });
  document.getElementById('type-breakdown').innerHTML = `🟠 Vrai/Faux: <strong style="color:var(--text)">${types.tf}</strong> &nbsp;|&nbsp; 🔵 Choix simple: <strong style="color:var(--text)">${types.sc}</strong> &nbsp;|&nbsp; 🟢 Choix multiple: <strong style="color:var(--text)">${types.mc}</strong>`;
  document.getElementById('chapter-breakdown').innerHTML = Object.entries(cats).map(([k,v])=>`📌 ${k}: <strong style="color:var(--text)">${v}</strong>`).join(' &nbsp;|&nbsp; ');
}

// ============================================================
// SESSIONS - LIENS CORRIGÉS
// ============================================================
function buildCandidateLink(code) {
  // Utilisation d'un paramètre d'URL standard ?session= qui fonctionne parfaitement
  const base = window.location.href.split('?')[0].split('#')[0];
  return base + '?session=' + encodeURIComponent(code);
}

function createNewSession() {
  if (!questionBank.length) { showToast('❌ Ajoutez d\'abord des questions !', '#dc2626'); return; }
  const code = 'SESSION-' + Math.random().toString(36).substring(2,8).toUpperCase();
  let pool = [...questionBank].filter(q => selectedForExam.has(q.id));
  if (!pool.length) pool = [...questionBank];
  if (examConfig.shuffle) pool = pool.sort(() => Math.random() - 0.5);
  const count = Math.min(examConfig.nQuestions, pool.length);

  activeSessions[code] = {
    code, questions: pool.slice(0,count), questionsCount: count,
    duration: examConfig.duration, passScore: examConfig.passThreshold,
    active: true, createdAt: new Date().toISOString(), candidates: {},
    link: buildCandidateLink(code)
  };
  saveToStorage(); 
  renderSessions(); 
  updateDashboard(); 
  updateLandingStats();

  document.getElementById('modal-session-code').textContent = code;
  document.getElementById('modal-session-info').textContent = `${count} questions · ${examConfig.duration} min · Seuil ${examConfig.passThreshold}%`;
  document.getElementById('modal-session-link').value = buildCandidateLink(code);
  openModal('session-created-modal');
}

function copyModalCode() {
  copyText(document.getElementById('modal-session-code').textContent, document.getElementById('modal-copy-code-btn'));
}

function copyModalLink() {
  copyText(document.getElementById('modal-session-link').value, document.getElementById('modal-copy-link-btn'));
}

async function closeSession(code) {
  const ok = await uniConfirm('Fermer cette session ?<br><small style="color:#64748b">Les candidats ne pourront plus l\'utiliser.</small>', '🔒');
  if (ok) { activeSessions[code].active = false; saveToStorage(); renderSessions(); showToast('✅ Session fermée', '#16a34a'); }
}

async function deleteSession(code) {
  const ok = await uniConfirm('Supprimer définitivement cette session ?<br><small style="color:#ef4444">Action irréversible.</small>', '🗑️');
  if (ok) { delete activeSessions[code]; saveToStorage(); renderSessions(); updateDashboard(); updateLandingStats(); showToast('🗑️ Session supprimée', '#dc2626'); }
}

