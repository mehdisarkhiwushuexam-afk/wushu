  const hBg=passed?'linear-gradient(135deg,#064e3b,#16a34a)':'linear-gradient(135deg,#7f1d1d,#b91c1c)';
  const html=`<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><title>Rapport — ${rec.candidateName}</title>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
  <style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Source Sans 3',sans-serif;background:#fff;color:#1e293b;font-size:13px}@media print{body{-webkit-print-color-adjust:exact;print-color-adjust:exact}.no-print{display:none!important}@page{size:A4;margin:12mm}}.pbtn{position:fixed;bottom:20px;right:20px;padding:12px 24px;background:linear-gradient(135deg,#003a7d,#1a7fd4);color:#fff;border:none;border-radius:8px;font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:1px;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.2)}</style>
  </head><body>
  <button class="pbtn no-print" onclick="window.print()">🖨️ Imprimer / PDF</button>
  <div style="max-width:780px;margin:0 auto;padding:24px">
    <div style="background:${hBg};border-radius:12px;padding:28px;text-align:center;color:#fff;margin-bottom:20px">
      <div style="font-family:'Oswald',sans-serif;font-size:11px;letter-spacing:3px;opacity:.8;margin-bottom:6px">IWUF — CERTIFICATION ARBITRE SANDA 2024</div>
      <div style="font-family:'Oswald',sans-serif;font-size:52px;font-weight:700;line-height:1">${pct}%</div>
      <div style="font-family:'Oswald',sans-serif;font-size:22px;font-weight:700;letter-spacing:2px;margin:6px 0">${passed?'✓ RÉUSSI':'✗ ÉCHEC'}</div>
      <div style="font-size:13px;opacity:.85">${passed?'Félicitations ! Certification validée.':'Seuil de '+rec.threshold+'% non atteint.'}</div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px">
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;text-align:center"><div style="font-family:'Oswald',sans-serif;font-size:24px;font-weight:700;color:#16a34a">${rec.correctCount}</div><div style="font-size:10px;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;margin-top:3px">Correctes</div></div>
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;text-align:center"><div style="font-family:'Oswald',sans-serif;font-size:24px;font-weight:700;color:#dc2626">${rec.wrongCount}</div><div style="font-size:10px;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;margin-top:3px">Incorrectes</div></div>
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;text-align:center"><div style="font-family:'Oswald',sans-serif;font-size:24px;font-weight:700;color:#005ab5">${(+rec.earnedPoints).toFixed(1)} / ${(+rec.totalPoints).toFixed(1)}</div><div style="font-size:10px;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;margin-top:3px">Points</div></div>
    </div>
    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;margin-bottom:20px">
      <div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid #e2e8f0;font-size:13px"><span style="color:#64748b">Arbitre</span><strong>${rec.candidateName}</strong></div>
      <div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid #e2e8f0;font-size:13px"><span style="color:#64748b">Session</span><strong>${rec.sessionCode}</strong></div>
