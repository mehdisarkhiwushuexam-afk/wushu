function startExam() {
  const code = document.getElementById('cand-session-code').value.trim().toUpperCase();
  const name = document.getElementById('cand-name').value.trim();
  const err = document.getElementById('cand-error');
  err.style.display = 'none';
  if (!code) { err.textContent='❌ Entrez le code de session'; err.style.display='block'; return; }
  if (!name) { err.textContent='❌ Entrez votre nom complet'; err.style.display='block'; return; }
  const session = activeSessions[code];
  if (!session) { err.textContent='❌ Session introuvable. Vérifiez le code (ex: SESSION-ABC123)'; err.style.display='block'; return; }
  if (!session.active) { err.textContent='❌ Cette session est terminée. Contactez l\'administrateur.'; err.style.display='block'; return; }
  currentExam = { 
    sessionCode:code, candidateName:name, questions:session.questions, 
    answers:new Array(session.questions.length).fill(null), currentIndex:0, 
    startTime:Date.now(), secondsLeft:session.duration*60, 
    totalPoints:session.questions.reduce((s,q)=>s+q.points,0), 
    passThreshold:session.passScore 
  };
  document.getElementById('exam-session-display').textContent = code;
  document.getElementById('exam-candidate-name').textContent = name.split(' ')[0];
  showScreen('exam');
  buildQGrid(); 
  renderExamQuestion(0); 
  startTimer();
}

