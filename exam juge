function startTimer(){clearInterval(timerInterval);updateTimerDisplay();timerInterval=setInterval(()=>{currentExam.secondsLeft--;updateTimerDisplay();if(currentExam.secondsLeft<=0){clearInterval(timerInterval);showToast('⏰ Temps écoulé !','#dc2626');finalSubmit();}},1000);}

function updateTimerDisplay(){const m=Math.floor(currentExam.secondsLeft/60),s=currentExam.secondsLeft%60;document.getElementById('timer-val').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');document.getElementById('timer-box').classList.toggle('urgent',currentExam.secondsLeft<120);}

