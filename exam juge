function filterQB(type, el) {
  currentFilter = type;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  if (el) el.classList.add('active');
  renderQB();
}

function renderQB() {
  const list = document.getElementById('question-bank-list');
  const search = (document.getElementById('qb-search')?.value||'').toLowerCase();
  let filtered = currentFilter==='all' ? questionBank : questionBank.filter(q=>(q.type||'sc')===currentFilter);
  if (search) filtered = filtered.filter(q => q.text.toLowerCase().includes(search));
  const typeLabels = {tf:'Vrai/Faux',sc:'Choix simple',mc:'Choix multiple'};
  list.innerHTML = filtered.length ? filtered.map(q => {
    const qi = questionBank.indexOf(q);
    const corrIdx = Array.isArray(q.answer)?q.answer[0]:(q.correct?q.correct[0]:q.answer);
    return `
    <div class="qb-item">
      <div class="qb-check ${selectedForExam.has(q.id)?'checked':''}" onclick="toggleSelect(${q.id},this)"></div>
      <div class="qb-info">
        <div class="qb-text">${q.text}</div>
        <div class="qb-tags">
          <span class="qb-tag ${q.type||'sc'}">${typeLabels[q.type||'sc']}</span>
          <span class="qb-tag">${q.chapter||q.category||'Général'}</span>
          <span class="qb-tag">${q.points} pt${q.points>1?'s':''}</span>
          <span class="qb-tag" style="border-color:var(--green-dark);color:var(--green)">✓ ${q.options[corrIdx]||'?'}</span>
        </div>
      </div>
      <div class="qb-actions">
        <button class="btn-icon edit" title="Éditer" onclick="editQuestion(${qi})">✏</button>
        <button class="btn-icon" title="Supprimer" onclick="deleteQuestion(${qi})">✕</button>
      </div>
    </div>`;
  }).join('') : '<div style="text-align:center;color:var(--muted);padding:30px">Aucune question trouvée.</div>';
  document.getElementById('selected-count').textContent = selectedForExam.size;
}

function toggleSelect(id, el) { 
  if(selectedForExam.has(id)) selectedForExam.delete(id); 
  else selectedForExam.add(id); 
  el.classList.toggle('checked'); 
  document.getElementById('selected-count').textContent = selectedForExam.size; 
}

async function deleteQuestion(i) { 
  const ok = await uniConfirm('Supprimer cette question ?','🗑️'); 
  if(!ok) return; 
  const id=questionBank[i].id; 
  questionBank.splice(i,1); 
  selectedForExam.delete(id); 
  saveToStorage(); 
  renderQB(); 
  updateDashboard(); 
}

function editQuestion(i) { 
  const q=questionBank[i]; 
  editingQIndex=i; 
  document.getElementById('add-title').textContent='Modifier la Question'; 
  document.getElementById('new-q-type').value=q.type||'sc'; 
  document.getElementById('new-q-chapter').value=q.chapter||q.category||'Règlement'; 
  document.getElementById('new-q-points').value=q.points; 
  document.getElementById('new-q-text').value=q.text; 
  updateAnswerFields(q); 
  adminNav('add',document.querySelector('.sidebar-item:nth-child(4)')); 
}

function selectAllQ() { questionBank.forEach(q=>selectedForExam.add(q.id)); renderQB(); }
function deselectAllQ() { selectedForExam.clear(); renderQB(); }

function updateAnswerFields(existingQ) {
  const type = document.getElementById('new-q-type')?.value || 'sc';
  const container = document.getElementById('answer-fields');
  if (!container) return;
  if (type === 'tf') {
    const cur = existingQ ? (Array.isArray(existingQ.answer)?existingQ.answer[0]:(existingQ.correct?existingQ.correct[0]:existingQ.answer)) : 0;
    container.innerHTML = `<div class="form-field"><label class="form-label">Bonne réponse</label><select class="config-input" id="new-q-tf-ans"><option value="0" ${cur===0?'selected':''}>Vrai</option><option value="1" ${cur===1?'selected':''}>Faux</option></select></div>`;
  } else {
    const nOpts = type==='mc' ? 5 : 4;
    const existOpts = existingQ ? existingQ.options : [];
    const existAns = existingQ ? (Array.isArray(existingQ.answer)?existingQ.answer:(existingQ.correct||[existingQ.answer])) : [0];
    let html = `<div class="form-field"><label class="form-label">Options ${type==='mc'?'(cochez toutes les bonnes réponses)':'(cochez la bonne réponse)'}</label>`;
    'ABCDE'.slice(0,nOpts).split('').forEach((l,i) => {
      const checked = existAns.includes(i);
      html += `<div class="option-row"><div class="option-label-badge">${l}</div><input type="text" class="form-input" id="new-opt-${i}" placeholder="Option ${l}..." value="${(existOpts[i]||'').replace(/"/g,'&quot;')}" style="flex:1;padding:8px 12px"><label style="display:flex;align-items:center;gap:4px;cursor:pointer;font-size:13px;color:var(--text);white-space:nowrap"><input type="${type==='mc'?'checkbox':'radio'}" name="correct-ans" value="${i}" ${checked?'checked':''} style="width:16px;height:16px;accent-color:var(--green)"> ✓</label></div>`;
    });
    html += '</div>';
    container.innerHTML = html;
  }
}

function saveQuestion() {
  const type = document.getElementById('new-q-type').value;
  const chapter = document.getElementById('new-q-chapter').value;
  const text = document.getElementById('new-q-text').value.trim();
  const points = parseFloat(document.getElementById('new-q-points').value)||1;
  if (!text) { showToast('❌ Entrez le texte de la question','#dc2626'); return; }
  let options, answer;
  if (type==='tf') {
    options=['Vrai','Faux']; 
    answer=parseInt(document.getElementById('new-q-tf-ans').value);
  } else {
    const nOpts=type==='mc'?5:4; 
    options=[];
    for(let i=0;i<nOpts;i++){const v=document.getElementById(`new-opt-${i}`)?.value.trim(); if(v) options.push(v);}
    if(options.length<2){showToast('❌ Minimum 2 options','#dc2626');return;}
    const checked=[...document.querySelectorAll('input[name="correct-ans"]:checked')].map(el=>parseInt(el.value));
    if(!checked.length){showToast('❌ Sélectionnez au moins une bonne réponse','#dc2626');return;}
    answer=type==='mc'?checked:checked[0];
  }
  const q={id:editingQIndex>=0?questionBank[editingQIndex].id:Date.now(),type,chapter,text,points,options,answer};
  if(editingQIndex>=0) questionBank[editingQIndex]=q; 
  else { questionBank.push(q); selectedForExam.add(q.id); }
  saveToStorage(); 
  resetAddForm(); 
  updateDashboard(); 
  updateLandingStats();
  showToast(editingQIndex>=0?'✅ Question modifiée !':'✅ Question ajoutée !','#16a34a');
  editingQIndex=-1;
  adminNav('questions',document.querySelector('.sidebar-item:nth-child(3)'));
}

function resetAddForm() { 
  editingQIndex=-1; 
  document.getElementById('add-title').textContent='Ajouter une Question'; 
  document.getElementById('new-q-type').value='sc'; 
  document.getElementById('new-q-chapter').value='Règlement'; 
  document.getElementById('new-q-points').value='1'; 
  document.getElementById('new-q-text').value=''; 
  updateAnswerFields(); 
}

