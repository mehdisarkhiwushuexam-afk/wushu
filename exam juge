function setupImportZone() {
  const iz=document.getElementById('import-zone'), fi=document.getElementById('csv-file-input');
  if(!iz||!fi) return;
  iz.addEventListener('click',()=>fi.click());
  fi.addEventListener('change',e=>{if(e.target.files[0]){const r=new FileReader();r.onload=e=>{document.getElementById('import-textarea').value=e.target.result;};r.readAsText(e.target.files[0]);}});
}

function parseCSV() {
  const text=document.getElementById('import-textarea').value.trim();
  if(!text){showToast('❌ Collez du contenu CSV','#dc2626');return;}
  const lines=text.split('\n').filter(l=>l.trim()&&!l.toLowerCase().startsWith('cat'));
  let added=0,errors=[];
  lines.forEach((line,i)=>{
    const p=line.split(';');
    if(p.length>=7){
      const opts=[p[2],p[3],p[4],p[5]].map(s=>s?.trim()).filter(Boolean);
      const ci='ABCD'.indexOf(p[6]?.trim().toUpperCase());
      if(p[1]?.trim()&&opts.length>=2&&ci>=0&&ci<opts.length){
        const q={id:Date.now()+i,type:'sc',chapter:p[0]?.trim()||'Général',text:p[1].trim(),options:opts,answer:ci,points:Math.max(.5,Math.min(10,parseFloat(p[7])||1))};
        questionBank.push(q);
        selectedForExam.add(q.id);
        added++;
      } else errors.push('L.'+(i+2));
    } else if(p.length>1) errors.push('L.'+(i+2));
  });
  if(added){
    saveToStorage();
    document.getElementById('import-result').innerHTML=`<div class="info-box success">✅ ${added} question(s) importée(s)${errors.length?' · ⚠️ '+errors.length+' erreur(s)':''}</div>`;
    document.getElementById('import-textarea').value='';
    updateDashboard();
    updateLandingStats();
  } else document.getElementById('import-result').innerHTML=`<div class="info-box error">❌ Aucune question valide. ${errors.join(', ')}</div>`;
}

