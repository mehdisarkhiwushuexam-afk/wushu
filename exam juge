// ============================================================
function buildQGrid(){document.getElementById('q-grid').innerHTML=currentExam.questions.map((_,i)=>`<button class="q-btn ${i===0?'current':''}" onclick="goToQuestion(${i})">${i+1}</button>`).join('');}

function renderExamQuestion(i) {
  const q=currentExam.questions[i], ans=currentExam.answers[i], n=currentExam.questions.length;
  document.querySelectorAll('.q-btn').forEach((b,j)=>{b.className='q-btn';if(j===i)b.classList.add('current');else if(currentExam.answers[j]!==null)b.classList.add('answered');});
  const tl={tf:'Vrai/Faux',sc:'Choix simple',mc:'Choix multiple'};
  document.getElementById('q-type-badge').textContent=tl[q.type||'sc']+' · Q'+(i+1);
  document.getElementById('q-type-badge').className='q-type-pill '+(q.type==='tf'?'tf':q.type==='mc'?'mc':'');
  document.getElementById('q-points-badge').textContent=q.points+' pt'+(q.points>1?'s':'');
  document.getElementById('question-text').textContent=q.text;
  document.getElementById('q-counter').textContent='Question '+(i+1)+' / '+n;
  document.getElementById('options-list').innerHTML=q.options.map((opt,oi)=>{const sel=ans!==null&&(Array.isArray(ans)?ans.includes(oi):ans===oi);return`<div class="option-item ${sel?'selected':''}" onclick="selectOption(${oi})"><div class="option-letter">${'ABCDE'[oi]}</div><div class="option-text">${opt}</div></div>`;}).join('');
  const answered=currentExam.answers.filter(a=>a!==null).length;
  document.getElementById('progress-text').textContent=answered+' / '+n+' répondu';
  document.getElementById('progress-fill').style.width=(answered/n*100)+'%';
  document.getElementById('exam-progress').style.width=(answered/n*100)+'%';
  document.getElementById('sidebar-unanswered').textContent='Non répondu : '+(n-answered);
  document.getElementById('btn-prev').style.display=i===0?'none':'';
  document.getElementById('btn-next').style.display=i===n-1?'none':'';
  document.getElementById('btn-submit').style.display=i===n-1?'':'none';
}

function selectOption(oi){const q=currentExam.questions[currentExam.currentIndex];if((q.type||'sc')==='mc'){if(!Array.isArray(currentExam.answers[currentExam.currentIndex]))currentExam.answers[currentExam.currentIndex]=[];const arr=currentExam.answers[currentExam.currentIndex],idx=arr.indexOf(oi);if(idx===-1)arr.push(oi);else arr.splice(idx,1);if(arr.length===0)currentExam.answers[currentExam.currentIndex]=null;}else currentExam.answers[currentExam.currentIndex]=oi;renderExamQuestion(currentExam.currentIndex);}

function goToQuestion(i){currentExam.currentIndex=i;renderExamQuestion(i);}

function prevQuestion(){if(currentExam.currentIndex>0){currentExam.currentIndex--;renderExamQuestion(currentExam.currentIndex);}}

function nextQuestion(){if(currentExam.currentIndex<currentExam.questions.length-1){currentExam.currentIndex++;renderExamQuestion(currentExam.currentIndex);}}

// ============================================================
// SUBMIT
// ============================================================
async function confirmSubmit() {
  const u=currentExam.answers.filter(a=>a===null).length, n=currentExam.questions.length;
  const msg=u>0?`⚠️ <strong>${u} question(s)</strong> sans réponse.<br><small style="color:#64748b">Terminer quand même ?</small>`:`Toutes les questions sont répondues. Confirmer la soumission ?`;
  const ok=await uniConfirm(msg, u>0?'⚠️':'✅');
  if(ok) finalSubmit();
}

function finalSubmit() {
  closeModal('submit-modal'); 
  clearInterval(timerInterval);
  const e=currentExam; 
  let pts=0, cor=0;
  e.questions.forEach((q,i)=>{const ans=e.answers[i]; if(ans===null)return; if(Array.isArray(q.answer)){const ua=(Array.isArray(ans)?ans:[ans]).slice().sort().join(',');if(ua===q.answer.slice().sort().join(','))pts+=q.points,cor++;}else{const c=q.correct?q.correct[0]:q.answer;if(ans===c)pts+=q.points,cor++;}});
  const total=e.questions.reduce((s,q)=>s+q.points,0);
  const pct=total>0?Math.round(pts/total*100):0;
  const passed=pct>=e.passThreshold;
  const ans=e.answers.filter(a=>a!==null).length;
  const durationSec=Math.floor((Date.now()-e.startTime)/1000);
  const wrong=e.questions.length-ans+(ans-cor);
  const rec={id:Date.now(),sessionCode:e.sessionCode,candidateName:e.candidateName,earnedPoints:pts,totalPoints:total,percentage:pct,passed,answeredCount:ans,totalQuestions:e.questions.length,threshold:e.passThreshold,dateTime:new Date().toLocaleDateString('fr-FR')+' '+new Date().toTimeString().substring(0,5),durationSec,correctCount:cor,wrongCount:wrong};
  if(activeSessions[e.sessionCode]?.candidates) activeSessions[e.sessionCode].candidates[e.candidateName]=rec;
  allResults.push(rec); 
  saveToStorage();
  submitToGForms(e.candidateName,e.sessionCode,pct);
  document.getElementById('result-header').className='results-header '+(passed?'pass':'fail');
  document.getElementById('result-icon').textContent=passed?'🏆':'📋';
  document.getElementById('result-score-big').textContent=pct+'%';
  document.getElementById('result-verdict').textContent=passed?'RÉUSSI':'ÉCHEC';
  document.getElementById('result-subtitle').textContent=passed?'Félicitations ! Vous êtes certifié(e).':'Seuil de '+e.passThreshold+'% non atteint.';
  document.getElementById('rb-correct').textContent=cor;
  document.getElementById('rb-wrong').textContent=wrong;
  document.getElementById('rb-score').textContent=pts.toFixed(1)+' / '+total.toFixed(1);
  document.getElementById('r-name').textContent=e.candidateName;
  document.getElementById('r-session').textContent=e.sessionCode;
  document.getElementById('r-answered').textContent=ans+' / '+e.questions.length;
  document.getElementById('r-threshold').textContent=e.passThreshold+'%';
  document.getElementById('r-duration').textContent=Math.floor(durationSec/60)+'m '+durationSec%60+'s';
  showScreen('results');
}

// ============================================================
// ADMIN RESULTS
// ============================================================
function renderAdminResults() {
  const t=allResults.length, p=allResults.filter(r=>r.passed).length;
  document.getElementById('res-total').textContent=t;
  document.getElementById('res-pass').textContent=p;
  document.getElementById('res-fail').textContent=t-p;
  document.getElementById('res-avg').textContent=t?Math.round(allResults.reduce((s,r)=>s+r.percentage,0)/t)+'%':'—';
  const tbody=document.getElementById('results-table-body');
  if(!t){tbody.innerHTML='<tr><td colspan="7" style="text-align:center;padding:20px;color:var(--muted)">Aucun résultat</td></tr>';return;}
  tbody.innerHTML=allResults.slice().reverse().map(r=>`
    <tr>
      <td style="font-size:12px">${r.dateTime}</td>
      <td style="font-family:Oswald,sans-serif">${r.sessionCode}</td>
      <td>${r.candidateName}</td>
      <td><strong>${(+r.earnedPoints).toFixed(1)} / ${(+r.totalPoints).toFixed(1)}</strong></td>
      <td><strong style="color:${r.passed?'var(--green)':'var(--red)'}">${r.percentage}%</strong></td>
      <td><span class="${r.passed?'badge-pass':'badge-fail'}">${r.passed?'✓ RÉUSSI':'✗ ÉCHEC'}</span></td>
      <td style="color:var(--muted)">${Math.floor(r.durationSec/60)}m${r.durationSec%60}s</td>
    </tr>`).join('');
}

// ============================================================
// SESSION ANALYSIS
// ============================================================
function populateSessionSelect(){const sel=document.getElementById('sa-select');const codes=[...new Set(allResults.map(r=>r.sessionCode))].sort();sel.innerHTML='<option value="all">— Toutes —</option>'+codes.map(c=>`<option value="${c}">${c}</option>`).join('');}

function renderAnalysis(){
  const code=document.getElementById('sa-select').value;
  let data=code==='all'?allResults:allResults.filter(r=>r.sessionCode===code);
  data=data.slice().sort((a,b)=>b.percentage-a.percentage||a.durationSec-b.durationSec);
  const t=data.length,p=data.filter(r=>r.passed).length;
  const avg=t?Math.round(data.reduce((s,r)=>s+r.percentage,0)/t):null;
  document.getElementById('sa-total').textContent=t||'—';
  document.getElementById('sa-pass').textContent=t?p:'—';
  document.getElementById('sa-fail').textContent=t?(t-p):'—';
  document.getElementById('sa-avg').textContent=avg!==null?avg+'%':'—';
  document.getElementById('sa-top').textContent=t?data[0].percentage+'%':'—';
  document.getElementById('sa-count').textContent=t?t+' résultat(s)':'';
  if(!t){document.getElementById('sa-tbody').innerHTML='<tr><td colspan="8" style="text-align:center;padding:30px;color:var(--muted)">Aucun résultat</td></tr>';return;}
  let rank=1;
  document.getElementById('sa-tbody').innerHTML=data.map((r,i)=>{if(i>0&&r.percentage<data[i-1].percentage)rank=i+1;const medal=rank===1?'🥇':rank===2?'🥈':rank===3?'🥉':rank;return`<tr><td style="text-align:center;font-size:16px">${medal}</td><td><strong>${r.candidateName}</strong></td><td style="font-family:Oswald,sans-serif;color:var(--gold)">${r.sessionCode}</td><td style="font-size:12px;color:var(--muted)">${r.dateTime}</td><td><strong>${(+r.earnedPoints).toFixed(1)} / ${(+r.totalPoints).toFixed(1)}</strong></td><td><strong style="color:${r.passed?'var(--green)':'var(--red)'}">${r.percentage}%</strong></td><td><span class="${r.passed?'badge-pass':'badge-fail'}">${r.passed?'✓ RÉUSSI':'✗ ÉCHEC'}</span></td><td style="color:var(--muted)">${Math.floor(r.durationSec/60)}m${String(r.durationSec%60).padStart(2,'0')}s</td></tr>`;}).join('');
}

function exportSessionCSV(){if(!allResults.length){showToast('Aucun résultat','#64748b');return;}const code=document.getElementById('sa-select').value;let data=code==='all'?allResults:allResults.filter(r=>r.sessionCode===code);data=data.slice().sort((a,b)=>b.percentage-a.percentage);let rank=1;const rows=[['Rang','Nom','Session','Date','Score','Total','%','Résultat','Durée']];data.forEach((r,i)=>{if(i>0&&r.percentage<data[i-1].percentage)rank=i+1;rows.push([rank,r.candidateName,r.sessionCode,r.dateTime,r.earnedPoints,r.totalPoints,r.percentage+'%',r.passed?'RÉUSSI':'ÉCHEC',Math.floor(r.durationSec/60)+'m'+String(r.durationSec%60).padStart(2,'0')+'s']);});const csv=rows.map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(';')).join('\n');const a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent('\uFEFF'+csv);a.download='analyse_'+(code==='all'?'toutes':code)+'_'+new Date().toISOString().split('T')[0]+'.csv';a.click();}

function exportCSV(){if(!allResults.length){showToast('Aucun résultat','#64748b');return;}const csv=[['Date','Session','Arbitre','Points','Total','%','Résultat','Durée']].concat(allResults.map(r=>[r.dateTime,r.sessionCode,r.candidateName,r.earnedPoints,r.totalPoints,r.percentage+'%',r.passed?'RÉUSSI':'ÉCHEC',Math.floor(r.durationSec/60)+'m'+r.durationSec%60+'s'])).map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(';')).join('\n');const a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent('\uFEFF'+csv);a.download='resultats_iwuf_'+new Date().toISOString().split('T')[0]+'.csv';a.click();}

async function clearAllResults(){const ok=await uniConfirm('Effacer <strong>TOUS</strong> les résultats ?<br><small style="color:#ef4444">Action irréversible.</small>','🗑️');if(ok){allResults=[];Object.values(activeSessions).forEach(s=>{if(s.candidates)s.candidates={};});saveToStorage();renderAdminResults();showToast('🗑️ Résultats effacés','#dc2626');}}

// ============================================================
// PRINT REPORT
// ============================================================
